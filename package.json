{
  "name": "flock-herd-electron",
  "version": "0.1.0",
  "private": true,
  "description": "Capa de hosts virtuales multiplataforma con Electron, Rust (napi-rs) y Caddy v2",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "npm run build:electron && wait-on http://127.0.0.1:5173 && electron .",
    "build:rust": "napi build --platform --release --manifest-path native/Cargo.toml",
    "build:native": "npm run build:rust",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:rust && npm run build:electron && npm run build:renderer",
    "package": "electron-builder",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path native/Cargo.toml",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "verify-host": "bash scripts/verify-host.sh",
    "clean": "rm -rf dist dist-electron native/target native/*.node",
    "preview": "vite preview"
  },
  "keywords": [
    "electron",
    "react",
    "rust",
    "napi-rs",
    "caddy"
  ],
  "license": "MIT",
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@radix-ui/react-menubar": "^1.2.1",
    "@tanstack/react-query": "^5.90.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.13.2",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/cli": "^3.11.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.1",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "wait-on": "^9.0.0"
  }
}
